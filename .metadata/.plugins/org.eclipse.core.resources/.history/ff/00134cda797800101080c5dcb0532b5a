package in.string;

import java.util.HashSet;

public class FirstRepeatChar {

	public static char firstRepeatChar(String name) {

		HashSet<Character> set = new HashSet<>();

		for (char ch : name.toCharArray()) { // geeks

			if (set.contains(ch)) {
				return ch;
			}

			set.add(ch);
		}

		return 'c';
	}

	public static void main(String[] args) {

		String name = "geeks";

		FirstRepeatChar obj = new FirstRepeatChar();
		char firstRepeatChar = FirstRepeatChar.firstRepeatChar(name);

	}
}
