package com.sham.abstractclassandmethod;

 abstract class Animal {
	public abstract void roam();
}

class Lion extends Animal{

	@Override
	public void roam() {
		System.out.println("Lion is roaming");		
	}
	
	public void roar() {
		System.out.println("Lion is roaring");
	}
}

