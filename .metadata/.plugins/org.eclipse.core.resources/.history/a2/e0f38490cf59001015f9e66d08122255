package in.patterns;

public class AlphabeticPatterns {

	public static void main(String[] args) {
		
		
//		A  
//		A B  
//		A B C  
//		A B C D  
			
		int i,j,k;
		
		for(i=1;i<=4;i++){
			
			for(char ch='A';ch<'A'+i;ch++) {
				
				System.out.print(ch+" ");
			}
			System.out.println();
		}
	}
}
