package com.sham.hasarelationship;

public class Car {

	private String name;
	private int model;
	private final Engine engine;	// Has a relation
	
	public Car(String name, int model) {
		super();
		this.name = name;
		this.model = model;
		this.engine = new Engine("battery", 1200);
	}

	@Override
	public String toString() {
		return "Car [name=" + name + ", model=" + model + ", engine=" + engine + "]";
	}
}
