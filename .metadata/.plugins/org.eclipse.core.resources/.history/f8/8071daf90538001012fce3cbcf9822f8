package in.string;


public class PalindromeNoChecks {

	public static void main(String[] args) {
		
		System.out.println("Enter the no for check palindrom or not");
		int num=121;
		
		int original=num;
		int reversed=0;
		
		while (original!=0) {
			
			int remender=original%10;
			reversed=reversed*10+remender;
			original=original/10;
		}
		
	}

}
